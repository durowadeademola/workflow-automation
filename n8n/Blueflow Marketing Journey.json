    {
      "parameters": {
        "jsCode": "// One place to build every step's personalized copy, so the send nodes\n// below stay simple string references instead of repeating template logic.\nconst c = $json;\nconst name = c.name || 'there';\nconst business = c.businessName || 'us';\n\nreturn [{\n  json: {\n    ...c,\n    businessName: business,\n    welcomeSubject: `Welcome, ${name}!`,\n    welcomeHtml: `<p>Hi ${name},</p><p>Thanks for reaching out to ${business} — we're excited to help.</p>`,\n    reminderSubject: `Still thinking it over, ${name}?`,\n    reminderHtml: `<p>Hi ${name},</p><p>Just checking in — let us know if you have any questions about ${business}'s services.</p>`,\n    testimonialSubject: 'What our customers are saying',\n    testimonialHtml: `<p>Hi ${name},</p><p>Here's what a customer just like you had to say about ${business}...</p>`,\n    offerSubject: `A little something for you, ${name}`,\n    offerHtml: `<p>Hi ${name},</p><p>As a thank-you for your interest in ${business}, here's a special offer just for you.</p>`,\n  }\n}];"
      },
      "id": "b6d1e93e-230d-4daa-bbcf-0190998be834",
      "name": "Personalize Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ]
    },
