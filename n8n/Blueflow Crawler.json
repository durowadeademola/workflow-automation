      "id": "faa4db71-3d52-4f7e-a425-d7dd4ee27dd0",
      "name": "Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2128,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\n\nfor (const inputItem of allItems) {\n  const item = inputItem.json;\n\n  results.push({\n    json: {\n      client_id: item.clientId,\n      url: item.url || '',\n      content: item.content || '',\n      embedding: item.embeddingString,\n      metadata: {\n        chunkIndex: item.chunkIndex || 0,\n        contentLength: item.content ? item.content.length : 0\n      }\n    }\n  });\n}\n\nreturn results;"
      },
