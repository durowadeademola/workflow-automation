      "id": "2b4b1414-a842-4af2-8304-762ac3bd281c",
      "name": "Delete Old Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1216,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "// ---- CONFIGURE PER CLIENT ----\nconst CLIENT_ID = 'blueflow-automation';\nconst WEBSITE_URL = 'http://127.0.0.1:8000';\nconst PAGES_TO_CRAWL = ['/api/widget-knowledge', '/api/widget-knowledges'];\n// --------------------------------\n\nconst pages = PAGES_TO_CRAWL.map(path => ({\n  clientId: CLIENT_ID,\n  baseUrl: WEBSITE_URL,\n  path,\n  fullUrl: WEBSITE_URL.replace(/\\/$/, '') + path\n}));\n\nreturn pages.map(p => ({ json: p }));"
      },
      "id": "41347fe1-f4cb-4a25-8274-d7fd0f84b008",
      "name": "Client Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1424,
        1008
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:5000/fetch",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.fullUrl }}"
            },
            {
              "name": "clientId",
              "value": "={{ $json.clientId }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          },
          "timeout": 15000
        }
      },
      "id": "441f1033-8557-4292-8419-683cb1a07fa7",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1648,
        1008
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\n\nfor (const inputItem of allItems) {\n  const item = inputItem.json;\n  const clientId = item.clientId;\n  const url = item.url;\n\n  let html = item.data || item.content || '';\n\n  let text = html\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<nav[^>]*>[\\s\\S]*?<\\/nav>/gi, '')\n    .replace(/<footer[^>]*>[\\s\\S]*?<\\/footer>/gi, '')\n    .replace(/<header[^>]*>[\\s\\S]*?<\\/header>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/\\\\n/g, ' ')\n    .replace(/\\\\t/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (text.length < 50) continue;\n\n  const CHUNK_SIZE = 500;\n  const OVERLAP = 50;\n  let start = 0;\n  let chunkIndex = 0;\n\n  while (start < text.length) {\n    const end = Math.min(start + CHUNK_SIZE, text.length);\n    const chunk = text.slice(start, end).trim();\n    if (chunk.length > 100) {\n      results.push({\n        json: {\n          clientId,\n          url,\n          content: chunk,\n          chunkIndex\n        }\n      });\n      chunkIndex++;\n    }\n    start += CHUNK_SIZE - OVERLAP;\n  }\n}\n\nreturn results;"
      },
