        2944,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\n\nfor (const inputItem of allItems) {\n  const item = inputItem.json;\n  const embedding = item.embedding;\n\n  if (!embedding || !Array.isArray(embedding)) continue;\n\n  results.push({\n    json: {\n      clientId: item.clientId,\n      url: item.url,\n      content: item.content,\n      chunkIndex: item.chunkIndex,\n      embeddingString: '[' + embedding.join(',') + ']',\n      embeddingLength: embedding.length\n    }\n  });\n}\n\nreturn results;"
      },
